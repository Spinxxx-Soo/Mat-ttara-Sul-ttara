# Backend env vars consumed by BE/src/main/resources/application.yml

DB_USERNAME=root
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_secret_at_least_32_chars_long

GOOGLE_ID=your_google_oauth_client_id
GOOGLE_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=postmessage

NAVER_ID=your_naver_oauth_client_id
NAVER_SECRET=your_naver_oauth_client_secret

AWS_KEY=your_aws_access_key
AWS_SECRET=your_aws_secret_key

AI_BASE_URL=http://localhost:5000
