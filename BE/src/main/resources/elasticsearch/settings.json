{
  "analysis": {
    "analyzer": {
      "nori_analyzer": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase", "nori_part_of_speech"]
      }
    },
    "filter": {
      "nori_part_of_speech": {
        "type": "nori_part_of_speech",
        "stoptags": ["E", "J", "SC", "SE", "SF", "SP", "SSC", "SSO", "SY", "UNA", "Unknown", "VA", "VCN", "VCP", "VSV", "VV", "VX", "XPN", "XSA", "XSN", "XSV"]
      }
    }
  }
}
