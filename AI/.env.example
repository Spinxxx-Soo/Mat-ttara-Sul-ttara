# AI runtime env vars used by apps/config.py

openai_api_key=your_openai_api_key
openai_model=gpt-4.1-mini
gms_api_url=http://localhost:8080

# Review collection script env vars
GOOGLE_API_KEY=your_google_places_api_key
DB_HOST=localhost
DB_USER=meal_user
DB_PASSWORD=change_me
DB_NAME=meal_reco

# 추천 API에서 단기/장기/장소 벡터·유사도 요약을 INFO 로그로 남김 (운영에서는 false 권장)
DEBUG_VECTOR_PIPELINE=false

# recommendReason을 LLM으로 짧게 다듬기 (false면 템플릿 문구 그대로, API 실패 시에도 원문 유지)
REWRITE_RECOMMEND_REASON_LLM=true
